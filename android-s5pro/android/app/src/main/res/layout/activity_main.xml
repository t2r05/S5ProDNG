<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="S5 Pro RAF → DNG 批量解码"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="6dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/pick"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+ 选择 RAF"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/convertAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:text="转换全部"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/adv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:text="参数"
            android:textSize="14sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/advPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="8dp"
        android:background="#F0F0F0">

        <SeekBar
            android:id="@+id/sbStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="75"/>

        <SeekBar
            android:id="@+id/sbDelay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="20"/>

        <SeekBar
            android:id="@+id/sbSmooth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="65"/>

        <TextView
            android:id="@+id/advVals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:gravity="center"/>

        <CheckBox
            android:id="@+id/fujiCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="同时输出富士色彩 JPEG（相机白平衡+富士色矩阵渲染，推荐）"
            android:textSize="13sp"
            android:checked="true"/>

        <Spinner
            android:id="@+id/sizePreset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Spinner
            android:id="@+id/demoSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/halfCheck"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="半尺寸快渲"
                android:textSize="13sp"/>

            <CheckBox
                android:id="@+id/dngCheck"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="输出 DNG"
                android:textSize="13sp"
                android:checked="true"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/effBW"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="黑白"
                android:textSize="13sp"/>

            <CheckBox
                android:id="@+id/effSepia"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="棕褐"
                android:textSize="13sp"/>

            <CheckBox
                android:id="@+id/effBright"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="亮度+"
                android:textSize="13sp"/>

            <CheckBox
                android:id="@+id/effContrast"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="对比+"
                android:textSize="13sp"/>
        </LinearLayout>

        <CheckBox
            android:id="@+id/renameDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="按拍摄时间重命名（S5_yyyyMMddHHmmss）"
            android:textSize="13sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/overall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp"/>

    <Button
        android:id="@+id/exportPdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="导出接触表 PDF"
        android:textSize="13sp"/>

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#DDD"
        android:dividerHeight="1dp"/>
</LinearLayout>
